# Copy this file to backend/.env and fill in whichever keys you have.
# The pipeline works with NONE of these set — it falls back to a local
# deterministic planner, procedurally generated scene art, and silent audio,
# so you can run and demo the full prompt->MP4 pipeline immediately.

# LLM used for planning (video plan: title, scenes, narration, captions)
ANTHROPIC_API_KEY=

# Visual generation for scene images (OpenAI Images API, gpt-image-1)
OPENAI_API_KEY=

# Text-to-speech for narration
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
